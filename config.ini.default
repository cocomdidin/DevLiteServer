[General]
AppName=Dev Lite Server
StartWithWindows=false
MinimizeToTray=true
AutoStartServices=false
CheckUpdatesOnStart=true

[Services]
Nginx=true
Php=true
Mysql=false
Postgresql=false
Redis=false
Mailpit=false

[Versions]
ActivePhp=php-8.4
ActiveNode=node-v24

[Ports]
HttpPort=80
HttpsPort=443
PhpFastCgiPort=9000
MysqlPort=3306
PostgreSqlPort=5432
RedisPort=6379
MailpitSmtpPort=1025
MailpitWebPort=8025
